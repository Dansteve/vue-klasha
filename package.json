{
  "name": "vue-klasha",
  "version": "1.0.0",
  "description": "Klasha payment gateway component for Vue 2.x. For Vue 3 use vue3-klasha.",
  "main": "dist/klasha.min.js",
  "module": "dist/klasha.esm.js",
  "unpkg": "dist/klasha.min.js",
  "jsdelivr": "dist/klasha.min.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/klasha.esm.js",
      "require": "./dist/klasha.min.js",
      "default": "./dist/klasha.min.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src --ext=js,vue",
    "lint:fix": "eslint src --ext=js,vue --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev": "webpack serve --config build/webpack.dev.js",
    "build": "webpack --config build/webpack.dist.js",
    "dist": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dansteve/vue-klasha.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "Klasha",
    "Vue",
    "Vuejs",
    "Vue 2",
    "Payment Gateway",
    "Payments",
    "Africa"
  ],
  "author": {
    "name": "Dansteve Adekanbi",
    "email": "danstevea@gmail.com",
    "url": "https://dansteve.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dansteve/vue-klasha/issues"
  },
  "homepage": "https://github.com/dansteve/vue-klasha#readme",
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "eslint-webpack-plugin": "^4.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vue": "^2.7.16",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
