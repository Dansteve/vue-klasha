{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "env": {
    "browser": true,
    "es2020": true,
    "node": true,
    "jest": true
  },
  "extends": ["plugin:vue/recommended"],
  "rules": {
    "space-before-function-paren": [2, "never"],
    "indent": ["error", 4],
    "camelcase": [2, { "properties": "never" }],
    "no-console": "error",
    "vue/multi-word-component-names": "off"
  }
}
